# Copy to .env and fill in. Never commit .env.

# --- Docker compose -----------------------------------------------------------
# cpu (default) or gpu (needs NVIDIA Container Toolkit / Docker Desktop + WSL2 GPU)
COMPOSE_PROFILES=cpu
# n8n image tag
N8N_VERSION=latest
TZ=Asia/Ho_Chi_Minh

# --- Voice Studio (your cloned voice) ------------------------------------------
# Voice Studio on THIS machine (outside Docker):  http://host.docker.internal:8000
# Voice Studio on another LAN machine:            http://192.168.1.50:8000
# (localhost/127.0.0.1 is rewritten to host.docker.internal automatically inside the container)
VOICE_STUDIO_URL=http://host.docker.internal:8000
VOICE_STUDIO_API_KEY=
VOICE_STUDIO_VOICE_ID=

# --- Anthropic (metadata, clip selection, auto chapters) ------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- faster-whisper -------------------------------------------------------------
# auto = CUDA if available, else CPU
WHISPER_DEVICE=auto
WHISPER_MODEL=large-v3-turbo

# --- Media service ----------------------------------------------------------------
MEDIA_PORT=8000
# Max number of long jobs running at the same time
MAX_CONCURRENT_JOBS=1
LOG_LEVEL=INFO

# --- n8n ------------------------------------------------------------------------
N8N_PORT=5678
# Public URL n8n uses for webhooks / Telegram buttons (must be reachable from your phone
# for the Approve/Reject buttons, e.g. via Cloudflare Tunnel or ngrok)
N8N_WEBHOOK_URL=http://localhost:5678/
# Base URL used in Telegram messages to link to the rendered video
MEDIA_PUBLIC_URL=http://localhost:8000
