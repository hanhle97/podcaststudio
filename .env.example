# Copy to .env and fill in. Never commit .env.

# --- Docker compose -----------------------------------------------------------
# cpu (default) or gpu (needs NVIDIA Container Toolkit / Docker Desktop + WSL2 GPU)
COMPOSE_PROFILES=cpu
# n8n image tag
N8N_VERSION=latest
TZ=Asia/Ho_Chi_Minh

# --- Voice Studio (your cloned voice) ------------------------------------------
# Voice Studio (OmniVoice) listens on port 3900 by default.
# Voice Studio on THIS machine (outside Docker):  http://host.docker.internal:3900
# Voice Studio on another LAN machine:            http://192.168.1.50:3900
# (localhost/127.0.0.1 is rewritten to host.docker.internal automatically inside the container)
VOICE_STUDIO_URL=http://host.docker.internal:3900
# only if that Voice Studio sets OMNIVOICE_API_KEY (sent as Bearer)
VOICE_STUDIO_API_KEY=
# id of your cloned voice: GET {VOICE_STUDIO_URL}/v1/audio/voices
VOICE_STUDIO_VOICE_ID=

# --- LLM (metadata, clip selection, auto chapters) ------------------------------
# claude_code = Claude Code CLI with your Claude subscription. Create the token once:
#   docker compose exec -it media-service-gpu claude setup-token   (or media-service-cpu)
LLM_PROVIDER=claude_code
LLM_MODEL=sonnet
CLAUDE_CODE_OAUTH_TOKEN=
# seconds before one LLM call is abandoned
LLM_TIMEOUT_S=300

# --- faster-whisper -------------------------------------------------------------
# auto = CUDA if available, else CPU
WHISPER_DEVICE=auto
WHISPER_MODEL=large-v3-turbo

# --- Media service ----------------------------------------------------------------
MEDIA_PORT=8000
# Max number of long jobs running at the same time
MAX_CONCURRENT_JOBS=1
LOG_LEVEL=INFO
# Chromium tabs Remotion renders with in parallel (empty = Remotion default, half the CPU cores)
REMOTION_CONCURRENCY=

# --- n8n ------------------------------------------------------------------------
N8N_PORT=5678
# Public URL n8n uses for webhooks / Telegram buttons (must be reachable from your phone
# for the Approve/Reject buttons, e.g. via Cloudflare Tunnel or ngrok)
N8N_WEBHOOK_URL=http://localhost:5678/
# n8n UI and OAuth sign-in (Google needs localhost or a real domain, not a LAN IP)
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Base URL used in Telegram messages to link to the rendered video
MEDIA_PUBLIC_URL=http://localhost:8000
# Your Telegram chat id (message @userinfobot to get it); the bot token goes into n8n credentials
TELEGRAM_CHAT_ID=
# private | unlisted | public
YOUTUBE_PRIVACY=private
# 22 = People & Blogs, 27 = Education, 28 = Science & Technology
YOUTUBE_CATEGORY_ID=22
# give up waiting for the media pipeline after this many minutes
PIPELINE_TIMEOUT_MIN=120
