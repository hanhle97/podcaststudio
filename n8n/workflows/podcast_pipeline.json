    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e89401f5-3bde-5fb2-acea-d3a08e535ed3",
              "name": "text",
              "value": "=✅ <b>Đã upload YouTube</b> ({{ $env.YOUTUBE_PRIVACY || 'private' }})\n{{ $('Tóm tắt tập').item.json.title }}\nhttps://youtu.be/{{ $('Upload YouTube').item.json.id }}\nPhụ đề: {{ $('Upload phụ đề').item.json.statusCode === 200 ? 'đã thêm' : 'lỗi ' + $('Upload phụ đề').item.json.statusCode }}\n{{ $('Episode').item.json.inbox_file ? 'Script đã chuyển vào inbox/done/' : '' }}",
              "type": "string"
            }
