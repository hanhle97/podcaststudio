      "id": "1a310562-efb9-59bb-8abb-90df1cc315fa",
      "name": "Lấy phụ đề SRT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4180,
        -260
      ]
    },
    {
      "parameters": {
        "jsCode": "const boundary = 'podcast_studio_srt';\nconst videoId = $('Upload YouTube').first().json.id;\nconst meta = { snippet: { videoId, language: 'vi', name: 'Tiếng Việt', isDraft: false } };\nconst srt = $input.first().json.data;\nconst body = `--${boundary}\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n` +\n  `${JSON.stringify(meta)}\\r\\n--${boundary}\\r\\nContent-Type: application/x-subrip\\r\\n\\r\\n` +\n  `${srt}\\r\\n--${boundary}--`;\nreturn [{ json: { body, boundary, videoId } }];"
      },
      "id": "38da9c2a-f5a6-59ca-9916-7a9e3dea852a",
      "name": "Soạn phụ đề",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4400,
        -260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/youtube/v3/captions?part=snippet&uploadType=multipart",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 60000
        },
        "authentication": "predefinedCredentialType",
